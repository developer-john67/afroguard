# Environment variables for AgroGuard

# Qwen VLM (OpenAI-compatible)
QWEN_API_KEY=your_api_key_here
QWEN_BASE_URL=https://api.example.com/v1
QWEN_VL_MODEL=qwen3-vl
QWEN_TIMEOUT_SECONDS=120
GENERATE_EXPLANATION=0
PLANT_MODEL_CONFIDENCE=0.70

# Optional OpenAI-compatible fallbacks. Add newly generated keys locally only.
REMOTE_PROVIDER_ORDER=openrouter,groq,mistral,aionlabs
FALLBACK_TIMEOUT_SECONDS=30
TEXT_PROVIDER_ORDER=openrouter,groq,mistral,aionlabs,primary
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
AIONLABS_API_KEY=
AIONLABS_MODEL=

# Server
HOST=https://agroguard.example.com
PORT=8000
DEMO_MODE=0
REPLAY_MODE=0

# Provenance
CLONE_DISTINCT_CLIENTS=2

# Database
DATABASE_PATH=agroguard.db